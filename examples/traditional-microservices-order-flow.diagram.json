{
  "schemaVersion": "2.0",
  "id": "traditional-microservices-order-flow",
  "title": "传统电商下单 · 判断与补偿流程",
  "description": "库存不足取消订单；支付失败取消订单并释放预留。同步结果直接响应，成功确认事件异步通知。本图为假设的教学示意。",
  "view": {
    "kind": "flow",
    "direction": "RIGHT",
    "theme": "light",
    "primaryPath": [
      "submit-gateway",
      "gateway-open",
      "open-reserve",
      "reserve-result",
      "stock-ok-payment",
      "payment-result",
      "paid-confirm",
      "confirm-success"
    ]
  },
  "groups": [],
  "nodes": [
    {
      "id": "submit",
      "kind": "start",
      "label": "提交下单请求",
      "summary": "Web / App",
      "details": "客户端提交下单请求。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "gateway",
      "kind": "process",
      "label": "网关鉴权",
      "summary": "鉴权 · 限流 · 路由",
      "details": "身份校验通过后将请求交给订单服务。失败鉴权不在本图展开。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "open-order",
      "kind": "process",
      "label": "创建待支付订单",
      "summary": "订单服务",
      "details": "建立待支付订单，具体状态和幂等规则需按真实系统确定。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "reserve",
      "kind": "process",
      "label": "预留库存",
      "summary": "库存服务",
      "details": "订单服务向库存服务请求预留；库存服务返回成功或不足。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "stock-ok",
      "kind": "decision",
      "label": "库存预留成功？",
      "summary": "订单服务判断",
      "details": "成功才进入支付；库存不足时取消待支付订单，不需要释放库存。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "charge",
      "kind": "process",
      "label": "发起同步收单",
      "summary": "支付服务 → 第三方渠道",
      "details": "教学场景限定第三方渠道立即返回确定支付结果；处理中、超时和异步回调未展开。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "paid",
      "kind": "decision",
      "label": "支付成功？",
      "summary": "订单服务判断",
      "details": "订单服务收到支付服务返回的确定结果。成功确认订单，失败执行补偿。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "confirm",
      "kind": "process",
      "label": "确认订单",
      "summary": "更新状态",
      "details": "订单服务更新订单状态，随后发布确认事件；状态更新与事件发布的可靠性策略未指定。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "success",
      "kind": "end",
      "label": "返回成功结果",
      "summary": "同步响应",
      "details": "向客户端返回成功结果。后续通知不阻塞此响应。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "stock-cancel",
      "kind": "process",
      "label": "取消待支付订单",
      "summary": "库存不足",
      "details": "由于预留未成功，只取消订单，不请求释放库存。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "stock-failure",
      "kind": "end",
      "label": "返回库存不足",
      "summary": "同步失败响应",
      "details": "通过原下单请求返回库存不足结果。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "payment-cancel",
      "kind": "process",
      "label": "取消待支付订单",
      "summary": "支付失败补偿",
      "details": "支付失败后取消订单；这是业务补偿，不等于跨库事务回滚。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "release",
      "kind": "process",
      "label": "释放已预留库存",
      "summary": "库存服务动作",
      "details": "订单服务请求同一个库存服务释放先前预留的库存；此节点是动作，不表示另一个库存服务实例。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "payment-failure",
      "kind": "end",
      "label": "返回支付失败",
      "summary": "同步失败响应",
      "details": "库存释放后返回支付失败结果；真实系统需要设计释放失败、重试与幂等。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "event-bus",
      "kind": "store",
      "label": "订单确认事件",
      "summary": "事件总线",
      "details": "成功确认后发布事件。消息中间件及投递语义未指定。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "notify",
      "kind": "process",
      "label": "通知服务",
      "summary": "异步消费",
      "details": "订阅确认事件并发送通知；渠道、重试与去重未展开。",
      "evidenceStatus": "assumed"
    }
  ],
  "edges": [
